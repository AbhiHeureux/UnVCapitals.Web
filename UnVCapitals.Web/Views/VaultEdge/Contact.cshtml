@{
    Layout = "_VaultEdgeLayout";
    ViewData["Title"] = "Contact Us";
    ViewData["ActivePage"] = "Contact";
    ViewData["Description"] = "Get in touch with U & V Financial Knowledge — for financial awareness queries and updates.";
}

<section class="ve-page-hero" style="background-image:url(/vaultedge/img/bg-img/22.jpg);">
    <div class="ve-page-hero-overlay"></div>
    <div class="container ve-page-hero-content">
        <span class="ve-section-tag">Get In Touch</span>
        <h1>We'd Love to <span>Hear From You</span></h1>
        <nav aria-label="breadcrumb">
            <ol class="ve-breadcrumb">
                <li><a asp-controller="VaultEdge" asp-action="Index">Home</a></li>
                <li class="active">Contact</li>
            </ol>
        </nav>
    </div>
</section>

<section class="ve-contact-cards-section">
    <div class="container">
        <div class="ve-contact-cards-grid">
            <div class="ve-contact-info-card wow fadeInUp" data-wow-delay="50ms"><div class="ve-ci-icon"><i class="fa fa-map-marker"></i></div><h5>Visit Us</h5><p>Marris Road,<br>Aligarh, Uttar Pradesh</p></div>
            <div class="ve-contact-info-card wow fadeInUp" data-wow-delay="150ms"><div class="ve-ci-icon"><i class="fa fa-envelope"></i></div><h5>Email Us</h5><p>unvcapital@@gmail.com<br><small>We reply within 24 hours</small></p></div>
            <div class="ve-contact-info-card wow fadeInUp" data-wow-delay="250ms"><div class="ve-ci-icon"><i class="fa fa-phone"></i></div><h5>Call / WhatsApp</h5><p>+91 94571 07010<br>+91 97617 75567<br>+91 98972 16175</p></div>
            <div class="ve-contact-info-card wow fadeInUp" data-wow-delay="400ms"><div class="ve-ci-icon"><i class="fa fa-clock-o"></i></div><h5>Business Hours</h5><p>Monday &ndash; Saturday<br><small>10:00 AM &ndash; 7:00 PM</small></p></div>
        </div>
    </div>
</section>

<section class="ve-section ve-contact-section">
    <div class="container">
        <div class="row">
            <div class="col-12 col-lg-7 wow fadeInLeft" data-wow-delay="100ms">
                <div class="ve-contact-form-wrap">
                    <span class="ve-section-tag">Send a Message</span>
                    <h2>Send Us a <span>Message</span></h2>
                    <p>Fill in the form and we'll get back to you within one business day.</p>
                    <form class="ve-contact-form" action="#" method="post">
                        <div class="ve-form-row">
                            <div class="ve-form-group"><label>Full Name</label><input type="text" placeholder="Your full name" required></div>
                            <div class="ve-form-group"><label>Email Address</label><input type="email" placeholder="Your email" required></div>
                        </div>
                        <div class="ve-form-row">
                            <div class="ve-form-group"><label>WhatsApp Number</label><input type="tel" placeholder="Your WhatsApp number"></div>
                            <div class="ve-form-group"><label>Topic of Interest</label>
                                <select>
                                    <option>Select a topic</option>
                                    <option>Financial Awareness</option>
                                    <option>Savings &amp; Budgeting</option>
                                    <option>Insurance Awareness</option>
                                    <option>Tax Basics</option>
                                    <option>Investment Education</option>
                                    <option>Retirement Planning</option>
                                    <option>Digital Financial Awareness</option>
                                </select>
                            </div>
                        </div>
                        <div class="ve-form-group"><label>Your Message</label><textarea rows="5" placeholder="Tell us how we can help..."></textarea></div>
                        <button type="submit" class="ve-btn-primary">Send Message <i class="fa fa-paper-plane"></i></button>
                    </form>
                </div>
            </div>
            <div class="col-12 col-lg-5 wow fadeInRight" data-wow-delay="200ms">
                <div class="ve-contact-aside">
                    <div class="ve-ca-box">
                        <h4>Why Reach Out</h4>
                        <ul class="ve-ca-list">
                            <li><i class="fa fa-check-circle"></i> Free educational content</li>
                            <li><i class="fa fa-check-circle"></i> Reply within 24 hours</li>
                            <li><i class="fa fa-check-circle"></i> No sales pressure &mdash; pure awareness</li>
                            <li><i class="fa fa-check-circle"></i> Simple, jargon-free language</li>
                            <li><i class="fa fa-check-circle"></i> Accessible across digital platforms</li>
                        </ul>
                    </div>
                    <div class="ve-ca-hours">
                        <h5><i class="fa fa-clock-o"></i> Business Hours</h5>
                        <ul>
                            <li><span>Monday &ndash; Saturday</span><strong>10:00 AM &ndash; 7:00 PM</strong></li>
                            <li><span>Sunday</span><strong>Closed</strong></li>
                        </ul>
                    </div>
                    <div class="ve-ca-social">
                        <h5>Follow Us</h5>
                        <div class="ve-social">
                            <a href="#"><i class="fa fa-facebook"></i></a>
                            <a href="#"><i class="fa fa-instagram"></i></a>
                            <a href="#"><i class="fa fa-youtube-play"></i></a>
                            <a href="#"><i class="fa fa-whatsapp"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
