@{
    Layout = "_VaultEdgeLayout";
    ViewData["Title"] = "About Us";
    ViewData["ActivePage"] = "About";
    ViewData["Description"] = "Learn about U & V Financial Knowledge — our story, vision, and mission for financial awareness.";
}

<section class="ve-page-hero" style="background-image:url(/vaultedge/img/bg-img/13.jpg);">
    <div class="ve-page-hero-overlay"></div>
    <div class="container ve-page-hero-content">
        <span class="ve-section-tag">Our Story</span>
        <h1>Spreading <span>Financial Awareness</span></h1>
        <nav aria-label="breadcrumb">
            <ol class="ve-breadcrumb">
                <li><a asp-controller="VaultEdge" asp-action="Index">Home</a></li>
                <li class="active">About Us</li>
            </ol>
        </nav>
    </div>
</section>

<section class="ve-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-12 col-lg-6 wow fadeInLeft" data-wow-delay="100ms">
                <div class="ve-about-img-stack">
                    <div class="ve-about-img-1 bg-img" style="background-image:url(/vaultedge/img/bg-img/14.jpg);"></div>
                    <div class="ve-about-img-2 bg-img" style="background-image:url(/vaultedge/img/bg-img/5.jpg);"></div>
                    <div class="ve-about-ribbon"><strong>U &amp; V</strong><span>Financial Knowledge</span></div>
                </div>
            </div>
            <div class="col-12 col-lg-6 wow fadeInRight" data-wow-delay="200ms">
                <div class="ve-about-text">
                    <span class="ve-section-tag">Who We Are</span>
                    <h2>Financial Knowledge for <span>Common People</span></h2>
                    <p class="ve-lead">U &amp; V Financial Knowledge is an educational and awareness initiative created to simplify financial concepts for common people.</p>
                    <p>In today's fast-changing world, understanding money management, savings, insurance, taxation, and financial planning has become essential for every individual. Our platform aims to provide clear, practical, and responsible financial awareness content through digital platforms including social media, WhatsApp updates, and educational resources.</p>
                    <p>We are committed to promoting financial literacy and encouraging disciplined financial habits.</p>
                    <div class="ve-about-features">
                        <div class="ve-af-item"><i class="fa fa-check"></i><span>Simple, easy-to-understand language</span></div>
                        <div class="ve-af-item"><i class="fa fa-check"></i><span>Educational and awareness focus</span></div>
                        <div class="ve-af-item"><i class="fa fa-check"></i><span>Accessible across digital platforms</span></div>
                        <div class="ve-af-item"><i class="fa fa-check"></i><span>Promoting disciplined financial habits</span></div>
                    </div>
                    <a asp-controller="VaultEdge" asp-action="Services" class="ve-btn-primary mt-30">View Our Services</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- VISION & MISSION -->
<section class="ve-mvv-section">
    <div class="container">
        <div class="ve-section-header text-center">
            <span class="ve-section-tag">Our Foundation</span>
            <h2>Vision &amp; <span>Mission</span></h2>
        </div>
        <div class="ve-mvv-grid">
            <div class="ve-mvv-card wow fadeInUp" data-wow-delay="100ms">
                <div class="ve-mvv-icon"><i class="fa fa-eye"></i></div>
                <h4>Our Vision</h4>
                <p>To create a financially aware and financially disciplined society where individuals make informed decisions for a secure and prosperous future.</p>
            </div>
            <div class="ve-mvv-card wow fadeInUp" data-wow-delay="250ms">
                <div class="ve-mvv-icon"><i class="fa fa-bullseye"></i></div>
                <h4>Our Mission</h4>
                <p>To spread financial awareness in simple language, educate people about savings, insurance, taxation, and financial planning, encourage responsible financial habits, and make financial knowledge accessible to everyone.</p>
            </div>
            <div class="ve-mvv-card wow fadeInUp" data-wow-delay="400ms">
                <div class="ve-mvv-icon"><i class="fa fa-heart"></i></div>
                <h4>Our Values</h4>
                <p>Clarity, responsibility, accessibility, and a deep commitment to promoting disciplined financial habits for individuals and families.</p>
            </div>
        </div>
    </div>
</section>

<!-- HOW WE SPREAD AWARENESS -->
<section class="ve-section ve-team-section">
    <div class="container">
        <div class="ve-section-header text-center">
            <span class="ve-section-tag">Our Approach</span>
            <h2>How We Spread <span>Awareness</span></h2>
            <p>We make financial knowledge available wherever you already are &mdash; through the platforms you use every day.</p>
        </div>
        <div class="row">
            <div class="col-12 col-sm-6 col-lg-3 wow fadeInUp" data-wow-delay="100ms">
                <div class="ve-mvv-card" style="height:100%;">
                    <div class="ve-mvv-icon"><i class="fa fa-share-alt"></i></div>
                    <h4>Social Media</h4>
                    <p>Regular awareness posts on Facebook, Instagram, and YouTube in simple, relatable language.</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3 wow fadeInUp" data-wow-delay="200ms">
                <div class="ve-mvv-card" style="height:100%;">
                    <div class="ve-mvv-icon"><i class="fa fa-whatsapp"></i></div>
                    <h4>WhatsApp Updates</h4>
                    <p>Practical financial tips and awareness updates delivered directly to your phone.</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3 wow fadeInUp" data-wow-delay="300ms">
                <div class="ve-mvv-card" style="height:100%;">
                    <div class="ve-mvv-icon"><i class="fa fa-book"></i></div>
                    <h4>Educational Resources</h4>
                    <p>Easy-to-follow guides, articles, and content explaining financial concepts step by step.</p>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-lg-3 wow fadeInUp" data-wow-delay="400ms">
                <div class="ve-mvv-card" style="height:100%;">
                    <div class="ve-mvv-icon"><i class="fa fa-users"></i></div>
                    <h4>Community Awareness</h4>
                    <p>Building a community where financial discipline and awareness are encouraged and shared.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ve-newsletter-section">
    <div class="container">
        <div class="ve-newsletter-wrap">
            <div class="ve-nl-left">
                <i class="fa fa-envelope-o"></i>
                <div>
                    <h3>Stay Financially Aware</h3>
                    <p>Subscribe for weekly financial awareness tips, in simple language &mdash; straight to your inbox.</p>
                </div>
            </div>
            <div class="ve-nl-right">
                <form class="ve-nl-form" action="#" method="post">
                    <input type="email" placeholder="Enter your email address" required>
                    <button type="submit">Subscribe</button>
                </form>
            </div>
        </div>
    </div>
</section>
