@{
    Layout = "_VaultEdgeLayout";
    ViewData["Title"] = "Our Services";
    ViewData["ActivePage"] = "Services";
    ViewData["Description"] = "Educational and awareness services from U & V Financial Knowledge.";
}

<section class="ve-page-hero" style="background-image:url(/vaultedge/img/bg-img/20.jpg);">
    <div class="ve-page-hero-overlay"></div>
    <div class="container ve-page-hero-content">
        <span class="ve-section-tag">What We Offer</span>
        <h1>Educational &amp; <span>Awareness Services</span></h1>
        <nav aria-label="breadcrumb">
            <ol class="ve-breadcrumb">
                <li><a asp-controller="VaultEdge" asp-action="Index">Home</a></li>
                <li class="active">Services</li>
            </ol>
        </nav>
    </div>
</section>

<section class="ve-section">
    <div class="container">
        <div class="ve-section-header text-center">
            <span class="ve-section-tag">Our Focus</span>
            <h2>Awareness Services for <span>Everyday Life</span></h2>
            <p>Practical financial knowledge across the topics that matter most &mdash; explained simply, focused on awareness.</p>
        </div>
        <div class="ve-services-grid">
            <div class="ve-service-card wow fadeInUp" data-wow-delay="100ms"><div class="ve-service-icon"><i class="icon-profits"></i></div><h4>Financial Awareness Programs</h4><p>Foundational financial literacy content covering budgeting, money habits, and informed decision making.</p><a href="#" class="ve-card-link">Learn more <i class="fa fa-long-arrow-right"></i></a></div>
            <div class="ve-service-card wow fadeInUp" data-wow-delay="200ms"><div class="ve-service-icon"><i class="icon-diamond"></i></div><h4>Insurance Awareness</h4><p>Understand life, health, and general insurance basics &mdash; what they cover, why they matter, and how to choose wisely.</p><a href="#" class="ve-card-link">Learn more <i class="fa fa-long-arrow-right"></i></a></div>
            <div class="ve-service-card wow fadeInUp" data-wow-delay="300ms"><div class="ve-service-icon"><i class="icon-piggy-bank"></i></div><h4>Savings &amp; Budget Planning</h4><p>Practical guidance on building savings habits and creating a realistic budget that fits your life.</p><a href="#" class="ve-card-link">Learn more <i class="fa fa-long-arrow-right"></i></a></div>
            <div class="ve-service-card wow fadeInUp" data-wow-delay="400ms"><div class="ve-service-icon"><i class="icon-smartphone-1"></i></div><h4>Tax Awareness</h4><p>Learn the basics of taxation in plain language &mdash; deductions, filing, and common tax-saving concepts.</p><a href="#" class="ve-card-link">Learn more <i class="fa fa-long-arrow-right"></i></a></div>
            <div class="ve-service-card wow fadeInUp" data-wow-delay="500ms"><div class="ve-service-icon"><i class="icon-coin"></i></div><h4>Retirement Awareness</h4><p>Understand why early planning matters and the key steps to a financially secure retirement.</p><a href="#" class="ve-card-link">Learn more <i class="fa fa-long-arrow-right"></i></a></div>
            <div class="ve-service-card wow fadeInUp" data-wow-delay="600ms"><div class="ve-service-icon"><i class="icon-money-1"></i></div><h4>Digital Financial Awareness</h4><p>Stay safe and informed online &mdash; UPI, online banking, fraud awareness, and digital money habits.</p><a href="#" class="ve-card-link">Learn more <i class="fa fa-long-arrow-right"></i></a></div>
            <div class="ve-service-card wow fadeInUp" data-wow-delay="700ms"><div class="ve-service-icon"><i class="fa fa-newspaper-o"></i></div><h4>Financial Content &amp; Updates</h4><p>Regular financial awareness content and updates shared through social media, WhatsApp, and our platform.</p><a href="#" class="ve-card-link">Learn more <i class="fa fa-long-arrow-right"></i></a></div>
        </div>

        <div style="margin-top:40px;padding:24px;background:#fff8e6;border-left:4px solid var(--ve-gold);border-radius:8px;">
            <p style="margin:0;font-style:italic;color:#555;"><strong>Note:</strong> All services and content are provided strictly for educational and awareness purposes only.</p>
        </div>
    </div>
</section>

<section class="ve-process-section">
    <div class="container">
        <div class="ve-section-header text-center">
            <span class="ve-section-tag">How It Works</span>
            <h2>Simple Steps to <span>Get Aware</span></h2>
        </div>
        <div class="ve-process-grid">
            <div class="ve-process-step wow fadeInUp" data-wow-delay="100ms"><div class="ve-process-num">01</div><h5>Connect With Us</h5><p>Reach out via WhatsApp, social media, or email to start receiving awareness content.</p></div>
            <div class="ve-process-arrow"><i class="fa fa-long-arrow-right"></i></div>
            <div class="ve-process-step wow fadeInUp" data-wow-delay="250ms"><div class="ve-process-num">02</div><h5>Pick Your Topics</h5><p>Tell us which focus areas interest you most &mdash; savings, insurance, tax, or others.</p></div>
            <div class="ve-process-arrow"><i class="fa fa-long-arrow-right"></i></div>
            <div class="ve-process-step wow fadeInUp" data-wow-delay="400ms"><div class="ve-process-num">03</div><h5>Receive Awareness</h5><p>Get clear, practical financial awareness content delivered in simple language.</p></div>
            <div class="ve-process-arrow"><i class="fa fa-long-arrow-right"></i></div>
            <div class="ve-process-step wow fadeInUp" data-wow-delay="550ms"><div class="ve-process-num">04</div><h5>Apply &amp; Share</h5><p>Apply the knowledge in your own life and help spread awareness in your community.</p></div>
        </div>
    </div>
</section>

<section class="ve-section ve-faq-section">
    <div class="container">
        <div class="row align-items-start">
            <div class="col-12 col-lg-5 wow fadeInLeft" data-wow-delay="100ms">
                <span class="ve-section-tag">Common Questions</span>
                <h2>Frequently Asked <span>Questions</span></h2>
                <p>Have a question we haven't covered? <a asp-controller="VaultEdge" asp-action="Contact" style="color:var(--ve-gold);">Reach out to us</a> &mdash; we're happy to help.</p>
                <a asp-controller="VaultEdge" asp-action="Contact" class="ve-btn-primary mt-30">Contact Us</a>
            </div>
            <div class="col-12 col-lg-7 wow fadeInRight" data-wow-delay="200ms">
                <div class="ve-faq-list">
                    <div class="ve-faq-item open"><div class="ve-faq-q"><span>Is U &amp; V Financial Knowledge a SEBI-registered advisor?</span><i class="fa fa-plus"></i></div><div class="ve-faq-a">No. We are an educational and awareness platform only. We are not SEBI-registered investment advisors unless specifically stated. Please consult qualified professionals before making financial decisions.</div></div>
                    <div class="ve-faq-item"><div class="ve-faq-q"><span>Do you give personalised investment advice?</span><i class="fa fa-plus"></i></div><div class="ve-faq-a">No. All content shared on this platform is for general educational and awareness purposes only and does not constitute personalised investment, tax, or financial advice.</div></div>
                    <div class="ve-faq-item"><div class="ve-faq-q"><span>How can I receive awareness content?</span><i class="fa fa-plus"></i></div><div class="ve-faq-a">You can follow us on social media (Facebook, Instagram, YouTube), join our WhatsApp updates, or visit our website regularly for educational resources.</div></div>
                    <div class="ve-faq-item"><div class="ve-faq-q"><span>Is the content free?</span><i class="fa fa-plus"></i></div><div class="ve-faq-a">Yes &mdash; our awareness content is shared with the goal of promoting financial literacy and accessible knowledge for everyone.</div></div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ve-cta-banner bg-img" style="background-image:url(/vaultedge/img/bg-img/6.jpg);">
    <div class="ve-cta-overlay"></div>
    <div class="container ve-cta-content">
        <div class="row align-items-center">
            <div class="col-12 col-lg-8"><h2>Ready to Take the First Step Towards <span>Financial Awareness?</span></h2><p>Connect with us on WhatsApp or social media for regular financial awareness updates in simple language.</p></div>
            <div class="col-12 col-lg-4 text-lg-right"><a asp-controller="VaultEdge" asp-action="Contact" class="ve-btn-white">Get In Touch</a></div>
        </div>
    </div>
</section>
