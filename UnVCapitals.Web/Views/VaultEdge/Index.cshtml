                <a asp-controller="VaultEdge" asp-action="Services" class="ve-card-link">Learn more <i class="fa fa-long-arrow-right"></i></a>
            </div>
            <div class="ve-service-card wow fadeInUp" data-wow-delay="400ms">
                <div class="ve-service-icon"><i class="icon-smartphone-1"></i></div>
                <h4>Tax Basics</h4>
                <p>Learn the fundamentals of taxation in plain language &mdash; deductions, filing, and more.</p>
                <a asp-controller="VaultEdge" asp-action="Services" class="ve-card-link">Learn more <i class="fa fa-long-arrow-right"></i></a>
            </div>
            <div class="ve-service-card wow fadeInUp" data-wow-delay="500ms">
                <div class="ve-service-icon"><i class="icon-money-1"></i></div>
                <h4>Investment Education</h4>
                <p>Understand investment instruments, risks, and the power of long-term compounding.</p>
                <a asp-controller="VaultEdge" asp-action="Services" class="ve-card-link">Learn more <i class="fa fa-long-arrow-right"></i></a>
            </div>
            <div class="ve-service-card wow fadeInUp" data-wow-delay="600ms">
                <div class="ve-service-icon"><i class="icon-coin"></i></div>
                <h4>Retirement Planning</h4>
                <p>Know the steps to plan early so retirement years are financially comfortable.</p>
                <a asp-controller="VaultEdge" asp-action="Services" class="ve-card-link">Learn more <i class="fa fa-long-arrow-right"></i></a>
            </div>
        </div>
    </div>
</section>

