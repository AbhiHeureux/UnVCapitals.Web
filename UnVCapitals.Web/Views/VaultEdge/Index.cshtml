<!-- ===== HERO ===== -->
<section class="ve-hero">
    <div class="ve-hero-left">
        <span class="ve-hero-badge">Educational &amp; Awareness Initiative</span>
        <h1>Welcome to U &amp; V <span class="ve-highlight">Financial Knowledge</span></h1>
        <p style="font-size:20px;font-weight:600;color:var(--ve-gold);margin-bottom:14px;">Chaliye Samay Se Aage</p>
        <p>We are dedicated to spreading financial awareness and practical money knowledge in simple and understandable language. Our goal is to help individuals and families make informed financial decisions for a secure and better future.</p>
        <div class="ve-hero-btns">
            <a asp-controller="VaultEdge" asp-action="Services" class="ve-btn-primary">Explore Focus Areas</a>
            <a asp-controller="VaultEdge" asp-action="About" class="ve-btn-ghost">Learn More</a>
        </div>
        <div class="ve-hero-stats">
            <div class="ve-stat"><strong>7+</strong><span>Focus Areas</span></div>
            <div class="ve-stat-divider"></div>
            <div class="ve-stat"><strong>100%</strong><span>Educational</span></div>
            <div class="ve-stat-divider"></div>
            <div class="ve-stat"><strong>Simple</strong><span>Language</span></div>
        </div>
    </div>
    <div class="ve-hero-right">
        <div class="ve-hero-img-main bg-img" style="background-image:url(/vaultedge/img/bg-img/1.jpg);"></div>
        <div class="ve-hero-img-accent bg-img" style="background-image:url(/vaultedge/img/bg-img/3.jpg);"></div>
        <div class="ve-float-card">
            <i class="fa fa-lightbulb-o"></i>
            <div><strong>Awareness</strong><span>For a Secure Future</span></div>
        </div>
    </div>
</section>

